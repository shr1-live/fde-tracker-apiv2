<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FdeTracker.Api\FdeTracker.Api.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The case types and scoring rules live in the API (shared with the web practice lab). -->
    <Using Include="FdeTracker.Api.Services.Lab" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixed test sets live at the repo root and are copied next to the tool. -->
    <Content Include="..\evals\*.json" Link="evals\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
