# Set these as environment variables (a .env file is NOT read automatically). On Render, use the dashboard. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed if your Supabase project still uses the legacy shared JWT secret (HS256). Leave empty otherwise.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=https://fde-learniing-tracker.vercel.app
ALLOWED_DOMAIN=fiftyfivetech.io
ADMIN_EMAIL=shivanshu.rai@fiftyfivetech.io
FREE_SEATS=3
PORT=3000
